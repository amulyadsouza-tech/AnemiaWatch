# ==============================================================================
# AnemiaWatch React Frontend - Environment Variables Configuration
# ==============================================================================

# Backend API Base URL
# For production on Vercel, set this to your deployed Render service URL:
VITE_API_URL=https://anemiawatch-backend.onrender.com

# For local development, leave VITE_API_URL blank so Vite proxies /api to http://127.0.0.1:8000
# VITE_API_URL=
