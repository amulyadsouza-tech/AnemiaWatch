# ==============================================================================
# AnemiaWatch Clinical API - Environment Variables Configuration
# ==============================================================================

# Database Connection (PostgreSQL in production, SQLite fallback in local dev)
# Render Internal: postgresql://user:password@dpg-xxxx-a:5432/anemiawatch_db
# Neon / Supabase: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/anemiawatch_db?sslmode=require
DATABASE_URL=postgresql://anemiawatch_user:your_secure_db_password@localhost:5432/anemiawatch_db

# Security & Cryptography (Generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-secure-random-64-character-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS & Deployment
ENVIRONMENT=production
FRONTEND_URL=https://anemiawatch.vercel.app
ALLOWED_ORIGINS=https://anemiawatch.vercel.app,http://localhost:5173

# Port (Assigned automatically by Render in production)
PORT=8000
